# Supabase Configuration
SUPABASE_URL=https://your-project-ref.your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Do NOT use SUPABASE_SERVICE_ROLE_KEY in edge functions
# Use SUPABASE_ANON_KEY instead

# Stripe Configuration (for membership checkout)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PRICE_ID=price_your-price-id-here  # The $10 CAD/month recurring Price ID

# Site Configuration
SITE_URL=http://127.0.0.1:8000  # Replace with your production domain

# Stripe Webhook Secret (required for webhook signature verification)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
